#!/usr/bin/env bash
# SPDX-License-Identifier: MPL-2.0
# Copyright (c) 2026 Jonathan D.A. Jewell <j.d.a.jewell@open.ac.uk>
#
# marid — Canonical Command-Line Interface for the Marid framework.

set -euo pipefail

MARID_VERSION="1.0.0"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
MARID_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

show_help() {
    cat <<EOF
Marid Framework CLI (v${MARID_VERSION})
Usage: marid <command> [options] [arguments]

Commands:
  generate proto <path> [out]           Emit Protocol Buffers v3 schema (.proto) from service
  generate openapi <path> [out]         Emit OpenAPI 3.1 specification (JSON) from service
  generate graphql <path> [out]         Emit GraphQL SDL schema from service
  generate capability-spec <path> --global-verbs GET
                                        Emit native gateway DSL v1 YAML (explicit global exposure)
  generate capability-spec <path> --deny-by-default
                                        Emit strict YAML for the paired patched gateway
  generate capability-spec <path> --global-verbs GET [--out FILE]
                           Emit native gateway DSL v1 YAML (explicit global exposure)
  generate capability-spec <path> --deny-by-default [--out FILE]
                           Emit strict YAML for the paired patched gateway
  routes <path>                         Inspect and display route table of a MaridApp
  check                                 Run full estate verification suite across Julia and Bun
  version, --version, -v                Display Marid framework version
  help, --help, -h                      Display this help message
EOF
}

case "${1:-help}" in
    version|--version|-v)
        echo "marid v${MARID_VERSION} (Julia 1.10+ / Bun 1.4+)"
        exit 0
        ;;
    help|--help|-h)
        show_help
        exit 0
        ;;
    generate)
        TARGET="${2:-}"
        FILE="${3:-}"
        OUT="${4:-}"
        if [[ -z "$TARGET" || -z "$FILE" ]]; then
            echo "Error: 'generate' requires <target> and <path> (e.g. marid generate capability-spec service.jl)" >&2
            exit 1
        fi
        if [[ "$TARGET" == "capability-spec" ]]; then
            # Flags are order-independent and never reach Julia as source text.
            global_verbs=""
            profile=""
            out_file=""
            shift 3
            while [[ $# -gt 0 ]]; do
                case "$1" in
                    --global-verbs)
                        [[ -n "$profile" ]] && { echo "Error: --global-verbs and --deny-by-default are exclusive" >&2; exit 1; }
                        [[ $# -ge 2 && -n "${2:-}" ]] || { echo "Error: --global-verbs needs a comma-separated verb list" >&2; exit 1; }
                        profile="legacy"; global_verbs="$2"; shift 2 ;;
                    --deny-by-default)
                        [[ -z "$profile" ]] || { echo "Error: --global-verbs and --deny-by-default are exclusive" >&2; exit 1; }
                        profile="strict"; shift ;;
                    --out)
                        [[ $# -ge 2 && -n "${2:-}" ]] || { echo "Error: --out needs a path" >&2; exit 1; }
                        out_file="$2"; shift 2 ;;
                    *)
                        echo "Error: unexpected capability-spec argument: $1" >&2
                        echo "Usage: marid generate capability-spec <path> (--global-verbs GET[,POST] | --deny-by-default) [--out FILE]" >&2
                        exit 1 ;;
                esac
            done
            [[ -n "$profile" ]] || {
                echo "Error: name the exposure policy explicitly: --global-verbs GET or --deny-by-default" >&2
                echo "Global verbs are public on ALL paths; no implicit default is emitted." >&2
                exit 1
            }
            if [[ "$profile" == "strict" && -n "$global_verbs" ]]; then
                echo "Error: --deny-by-default takes no global verbs" >&2
                exit 1
            fi
            if [[ -n "$out_file" ]]; then
                # Never open the live policy for writing before the emitter has
                # succeeded: piping through tee truncates the target first, so one
                # bad service file would leave an empty file where a working gateway
                # policy was. Write aside, echo it, rename only on success.
                tmp_file="$(mktemp "${out_file}.tmp.XXXXXX")"
                if julia --startup-file=no --project="$MARID_ROOT/packages/MaridIR" \
                    "$MARID_ROOT/scripts/emit-capability-spec.jl" "$FILE" "$global_verbs" "$profile" > "$tmp_file"; then
                    cat "$tmp_file"
                    mv -f "$tmp_file" "$out_file"
                else
                    rc=$?
                    rm -f "$tmp_file"
                    echo "marid: capability-spec generation failed; ${out_file} left untouched" >&2
                    exit "$rc"
                fi
            else
                julia --startup-file=no --project="$MARID_ROOT/packages/MaridIR" \
                    "$MARID_ROOT/scripts/emit-capability-spec.jl" "$FILE" "$global_verbs" "$profile"
            fi
            exit 0
        fi

        cd "$MARID_ROOT"
        OUTPUT_CONTENT=$(julia --project=packages/MaridIR -e '
            if isdir("packages")
                for p in readdir("packages")
                    pkg_dir = joinpath("packages", p)
                    if isdir(pkg_dir)
                        pushfirst!(LOAD_PATH, abspath(pkg_dir))
                    end
                end
            end
            using MaridIR
            using MaridOpenAPI
            using MaridGraphQL

            target = ARGS[1]
            filepath = ARGS[2]

            function is_descriptor(val::Any)::Bool
                val isa ServiceDescriptor && return true
                try
                    return nameof(typeof(val)) == :ServiceDescriptor && hasfield(typeof(val), :methods)
                catch
                    return false
                end
            end

            function search_descriptor(mod::Module, seen::Union{Nothing, Set{Module}}=nothing)::Any
                if seen === nothing
                    seen = Set{Module}()
                end
                mod in seen && return nothing
                push!(seen, mod)
                for name in names(mod, all=true)
                    val = try getfield(mod, name) catch; nothing end
                    if is_descriptor(val)
                        return val
                    elseif val isa Function
                        app = try Base.invokelatest(applicable, val) catch; false end
                        if app
                            res = try Base.invokelatest(val) catch; nothing end
                            if is_descriptor(res)
                                return res
                            end
                        end
                    elseif val isa Module && val !== mod && val !== Main && val !== Base && val !== Core
                        sub = search_descriptor(val, seen)
                        if sub !== nothing
                            return sub
                        end
                    end
                end
                return nothing
            end

            function resolve_service(fp::String)::Any
                if isfile(fp)
                    m = Module()
                    try
                        Base.include(m, abspath(fp))
                        found = search_descriptor(m)
                        if found !== nothing
                            return found
                        end
                    catch err
                        @warn "Error evaluating $fp: $err"
                    end
                end
                return ServiceDescriptor(splitext(basename(fp))[1], "1.0.0", TypeDescriptor[], MethodDescriptor[])
            end

            svc = resolve_service(filepath)

            if target == "proto"
                print(emit_proto(svc))
            elseif target == "openapi"
                print(emit_openapi_json(svc))
            elseif target == "graphql"
                print(emit_graphql_sdl(svc))
            else
                println("// Unknown target $target for $filepath")
            end
        ' "$TARGET" "$FILE")

        if [[ -n "$OUT" && "$OUT" != "--global-verbs" && "$OUT" != "--deny-by-default" ]]; then
            echo "$OUTPUT_CONTENT" > "$OUT"
            echo "Wrote $TARGET to $OUT"
        else
            echo "$OUTPUT_CONTENT"
        fi
        ;;
    routes)
        FILE="${2:-}"
        if [[ -z "$FILE" ]]; then
            echo "Error: 'routes' requires <path> (e.g. marid routes service.jl)" >&2
            exit 1
        fi
        cd "$MARID_ROOT"
        julia --project=packages/MaridIR -e '
            if isdir("packages")
                for p in readdir("packages")
                    pkg_dir = joinpath("packages", p)
                    if isdir(pkg_dir)
                        pushfirst!(LOAD_PATH, abspath(pkg_dir))
                    end
                end
            end
            using MaridIR

            filepath = ARGS[1]
            function is_descriptor(val::Any)::Bool
                val isa ServiceDescriptor && return true
                try
                    return nameof(typeof(val)) == :ServiceDescriptor && hasfield(typeof(val), :methods)
                catch
                    return false
                end
            end

            function search_descriptor(mod::Module, seen::Union{Nothing, Set{Module}}=nothing)::Any
                if seen === nothing
                    seen = Set{Module}()
                end
                mod in seen && return nothing
                push!(seen, mod)
                for name in names(mod, all=true)
                    val = try getfield(mod, name) catch; nothing end
                    if is_descriptor(val)
                        return val
                    elseif val isa Function
                        app = try Base.invokelatest(applicable, val) catch; false end
                        if app
                            res = try Base.invokelatest(val) catch; nothing end
                            if is_descriptor(res)
                                return res
                            end
                        end
                    elseif val isa Module && val !== mod && val !== Main && val !== Base && val !== Core
                        sub = search_descriptor(val, seen)
                        if sub !== nothing
                            return sub
                        end
                    end
                end
                return nothing
            end

            function resolve_service(fp::String)::Any
                if isfile(fp)
                    m = Module()
                    try
                        Base.include(m, abspath(fp))
                        return search_descriptor(m)
                    catch err
                        @warn "Error evaluating $fp: $err"
                    end
                end
                return nothing
            end

            svc = resolve_service(filepath)
            if svc !== nothing
                println("Routes for $(svc.name) (v$(svc.version)):")
                for m in svc.methods
                    println("  $(rpad(uppercase(m.http_method), 7)) $(rpad(isempty(m.route_path) ? "/" * m.name : m.route_path, 30)) -> $(m.name) ($(m.streaming))")
                end
            else
                println("No ServiceDescriptor found in $filepath")
            end
        ' "$FILE"
        ;;
    check)
        # The gate this recipe publishes is "every package suite passes". Four
        # things are needed to mean that, and the previous implementation (a
        # Python loop) had none of them: it named a package `ArangoDB` that has
        # been `MaridArango` for weeks, so the loop could never pass; it did not
        # bootstrap, so a fresh clone failed on intra-family path deps that CI
        # develops first; it ran julia without --startup-file=no, so a user's
        # startup file could change the result; and it asserted only a process
        # return code, so a `julia` that exits 0 without running anything was
        # reported as "All 13 packages passed!". See
        # docs/audits/recon-2026-10-21.adoc (C01).
        cd "$MARID_ROOT"
        command -v julia >/dev/null 2>&1 || {
            echo "marid: julia not found on PATH; this recipe runs 13 Julia suites." >&2
            echo "marid: install the pinned toolchain (mise.toml) or use --project=<pkg> directly." >&2
            exit 2
        }
        packages=(
            MaridIR MaridCodec MaridOpenAPI MaridRPC MaridGraphQL MaridTransport
            MaridCore MaridArango MaridStorage MaridControl MaridLive MaridCRDT
            MaridRaft
        )
        failed=0
        for pkg in "${packages[@]}"; do
            suite="packages/$pkg/test/runtests.jl"
            # A name that does not exist must be an error, never a pass. This is
            # the exact defect C01 records.
            if [[ ! -d "packages/$pkg" ]]; then
                echo "marid: no such package directory: packages/$pkg" >&2
                failed=1
                continue
            fi
            if [[ ! -f "$suite" ]]; then
                echo "marid: no test suite at $suite" >&2
                failed=1
                continue
            fi
            # Same two steps, same order, as .github/workflows/julia-ci.yml.
            if ! julia --startup-file=no scripts/bootstrap.jl "packages/$pkg" >/dev/null; then
                echo "marid: bootstrap FAILED for $pkg" >&2
                failed=1
                continue
            fi
            if ! julia --startup-file=no --project="packages/$pkg" "$suite"; then
                echo "marid: test suite FAILED for $pkg" >&2
                failed=1
                continue
            fi
            echo "  ok  $pkg"
        done
        if [[ "$failed" -ne 0 ]]; then
            echo "marid: at least one package suite failed (see above)" >&2
            exit 1
        fi
        echo "All ${#packages[@]} package suites passed."
        ;;
    *)
        echo "Unknown command: $1" >&2
        show_help >&2
        exit 1
        ;;
esac
