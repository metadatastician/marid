# SPDX-License-Identifier: MPL-2.0
# Marid Container Image
#
# Multi-stage build template for Chainguard Wolfi base images.
# Customise the builder stage for your language and copy the
# resulting binary/release into the minimal runtime stage.
#
# This is the Tier-A artifact: a plain OCI image, buildable by ANY
# OCI-compliant engine — podman (recommended), nerdctl, or docker.
# It carries no hard dependency on the stapeln tier; the cerro-torre /
# svalinn files under build/container/stapeln/ are referenced only as labels.
#
# Build (engine-agnostic — substitute podman | nerdctl | docker):
#   podman build -t marid:latest -f build/container/Containerfile .
#
# Run:
#   podman run -p 6274:6274 marid:latest
#
# Run with persistent volume:
#   podman run -p 6274:6274 -v marid-data:/data marid:latest
#
# Via the Justfile (auto-detects engine, prefers cerro-torre when present):
#   just container-build

# ============================================================================
# Stage 1: Builder
# ============================================================================
#
# Install build tools and compile the application.
# This stage is discarded after the build — only the compiled output
# is copied into the runtime stage.
#
# Language-specific examples (uncomment the one you need):
#
# --- Rust ---
#   RUN apk add --no-cache rust pkgconf build-base
#   COPY Cargo.toml Cargo.lock ./
#   COPY src/ ./src/
#   RUN cargo build --release
#   # Output: /build/target/release/marid
#
# --- Elixir ---
#   RUN apk add --no-cache erl27-elixir-1.18 erlang-27 erlang-27-dev git build-base
#   COPY mix.exs mix.lock ./
#   COPY lib/ ./lib/
#   COPY config/ ./config/
#   ENV MIX_ENV=prod
#   RUN mix local.hex --force && mix local.rebar --force && \
#       mix deps.get --only prod && mix compile && mix release
#   # Output: /build/_build/prod/rel/marid/
#
# --- Zig ---
#   RUN apk add --no-cache zig build-base
#   COPY build.zig build.zig.zon ./
#   COPY src/ ./src/
#   RUN zig build -Doptimize=ReleaseFast
#   # Output: /build/zig-out/bin/marid
#
# Base image: `:latest` is right for a template scaffold (Chainguard rebuilds
# Wolfi daily). For PRODUCTION builds, pin by digest for reproducibility/supply-
# chain integrity, e.g.:
#   FROM cgr.dev/chainguard/wolfi-base:latest@sha256:<digest> AS builder
# (cerro-torre's .ctp signing in build/container/stapeln/ records the resolved digest.)
FROM cgr.dev/chainguard/wolfi-base:latest AS builder

# TODO: Install your language toolchain
RUN apk add --no-cache build-base

WORKDIR /build

# TODO: Copy source files and build
COPY . .
# RUN <your-build-command>

# ============================================================================
# Stage 2: Runtime
# ============================================================================
#
# Minimal production image. Only the compiled binary/release and runtime
# dependencies are included. No compilers, no source code, no build tools.
#
FROM cgr.dev/chainguard/wolfi-base:latest

# OCI image labels (compatible with cerro-torre .ctp bundle metadata)
LABEL org.opencontainers.image.title="Marid" \
      org.opencontainers.image.description="Julia-first framework for web applications, APIs, and reactive scientific dashboards, with interoperable protocols and frontend independence." \
      org.opencontainers.image.url="https://github.com/metadatastician/marid" \
      org.opencontainers.image.source="https://github.com/metadatastician/marid" \
      org.opencontainers.image.vendor="hyperpolymath" \
      org.opencontainers.image.licenses="MPL-2.0" \
      org.opencontainers.image.authors="Jonathan D.A. Jewell <j.d.a.jewell@open.ac.uk>" \
      dev.cerrotorre.manifest="build/container/stapeln/manifest.toml" \
      dev.cerrotorre.gatekeeper="build/container/stapeln/.gatekeeper.yaml" \
      dev.stapeln.compose="build/container/stapeln/compose.toml"

# Install minimal runtime dependencies.
# Adjust this list for your application:
#   - ca-certificates: TLS root certificates
#   - curl: health check probe
#   - libstdc++: C++ standard library (if needed by native deps)
#   - ncurses: terminal UI (if needed, e.g. Elixir IEx)
RUN apk add --no-cache ca-certificates curl

# Create non-root user for the application.
# Running as root inside containers is a security anti-pattern.
RUN addgroup -S appuser && adduser -S appuser -G appuser

WORKDIR /app

# TODO: Copy compiled binary/release from builder stage.
# Examples:
#   COPY --from=builder /build/target/release/marid /app/marid
#   COPY --from=builder /build/_build/prod/rel/marid /app/release/
#   COPY --from=builder /build/zig-out/bin/marid /app/marid

# Copy entrypoint script
COPY build/container/entrypoint.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh

# OPTIONAL (Tier C — stapeln). A pure OCI image does NOT need these baked in:
# svalinn reads .gatekeeper.yaml from a mounted volume (see stapeln/compose.toml),
# and cerro-torre reads manifest.toml at pack time. Uncomment only if you want
# the policy/manifest embedded in the image itself.
# COPY build/container/stapeln/.gatekeeper.yaml /etc/svalinn/gatekeeper.yaml
# COPY build/container/stapeln/manifest.toml /app/manifest.toml

# Create data directory for persistent storage (mountable volume)
RUN mkdir -p /data && chown appuser:appuser /data

# Set ownership of the application directory
RUN chown -R appuser:appuser /app

# Environment variables — customise for your application
ENV APP_HOST=[::]
ENV APP_PORT=6274
ENV APP_LOG_FORMAT=json
ENV APP_DATA_DIR=/data

# Declare /data as a volume for persistent storage
VOLUME ["/data"]

# Run as non-root
USER appuser

# Expose the application port
EXPOSE 6274

# Health check — the application must respond 2xx at /health
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -sf http://localhost:${APP_PORT}/health || exit 1

ENTRYPOINT ["/app/entrypoint.sh"]
