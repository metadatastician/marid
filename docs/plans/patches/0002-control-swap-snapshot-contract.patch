diff --git a/packages/MaridControl/src/MaridControl.jl b/packages/MaridControl/src/MaridControl.jl
index cc9d157..e2f50f7 100644
--- a/packages/MaridControl/src/MaridControl.jl
+++ b/packages/MaridControl/src/MaridControl.jl
@@ -43,8 +43,25 @@ function get_snapshot(cfg::AtomicConfig)::Snapshot
     return @atomic cfg.current
 end
 
+"""
+    swap_snapshot!(cfg::AtomicConfig, next::Snapshot) -> Snapshot
+
+Install `next` as the current snapshot and return it, mirroring
+`update_snapshot!` (which also returns the snapshot it installed).
+
+`@atomicreplace` returns a `NamedTuple{(:old, :success)}`, not a `Snapshot`;
+annotating this function `::Snapshot` therefore made the previous definition
+throw `MethodError: Cannot convert ... to Snapshot` on EVERY call, and the
+absence of a test is why it survived from 2026-09-19 to this change
+(`docs/audits/recon-2026-10-21.adoc`, C03). The compare-and-swap below reads and
+replaces the same value, so it always succeeds; `success` is asserted rather
+than assumed so a future change to the atomic cannot silently return the wrong
+snapshot.
+"""
 function swap_snapshot!(cfg::AtomicConfig, next::Snapshot)::Snapshot
-    return @atomicreplace cfg.current cfg.current => next
+    res = @atomicreplace cfg.current cfg.current => next
+    res.success || error("snapshot swap failed unexpectedly")
+    return next
 end
 
 function update_snapshot!(mutator::Function, cfg::AtomicConfig)::Snapshot
diff --git a/packages/MaridControl/test/runtests.jl b/packages/MaridControl/test/runtests.jl
index 1d1fc83..fbd4192 100644
--- a/packages/MaridControl/test/runtests.jl
+++ b/packages/MaridControl/test/runtests.jl
@@ -22,6 +22,23 @@ using MaridControl
         @test s2.data["cluster_name"] == "node-alpha"
     end
 
+    # 1b. swap_snapshot! returns the installed snapshot (C03)
+    @testset "swap_snapshot! installs and returns the new snapshot" begin
+        cfg = AtomicConfig(Snapshot(0, MaridControl.now(MaridControl.UTC), Dict{String, Any}("a" => 1)))
+        next = Snapshot(1, MaridControl.now(MaridControl.UTC), Dict{String, Any}("a" => 2))
+
+        installed = swap_snapshot!(cfg, next)   # was: MethodError on every call
+        @test installed isa Snapshot
+        @test installed === next
+        @test installed.version == 1
+        @test get_snapshot(cfg).version == 1
+        @test get_snapshot(cfg).data["a"] == 2
+
+        # A swap is not a merge: the previous payload does not survive unless the
+        # caller put it there. Documented contract, asserted here.
+        @test !haskey(get_snapshot(cfg).data, "b")
+    end
+
     # 2. Sequential Log Abstraction
     @testset "Sequential Log Append & Playback" begin
         log = SequentialLog()
