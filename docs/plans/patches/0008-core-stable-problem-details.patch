diff --git a/packages/MaridCore/src/errors.jl b/packages/MaridCore/src/errors.jl
index a76617b..4dacd66 100644
--- a/packages/MaridCore/src/errors.jl
+++ b/packages/MaridCore/src/errors.jl
@@ -9,7 +9,7 @@ RFC 9457 Problem Details and stable domain error hierarchy for Marid.
 
 export MaridError, NotFoundError, ValidationError, UnauthorizedError,
        ConflictError, TimeoutError, InternalError,
-       status_code, problem_details
+       status_code, problem_details, error_slug
 
 abstract type MaridError <: Exception end
 
@@ -62,13 +62,49 @@ status_code(::TimeoutError) = 504
 status_code(::InternalError) = 500
 status_code(::MaridError) = 500
 
-# RFC 9457 Problem Details mapping
-function problem_details(err::MaridError; instance::String="")::Dict{String, Any}
-    Dict{String, Any}(
-        "type" => "https://marid.hyperpolymath.org/errors/$(typeof(err))",
-        "title" => string(typeof(err)),
+# A stable slug per error kind. RFC 9457 `type` identifies the PROBLEM KIND; a
+# URI built from `typeof(err)` produced
+# "https://marid.hyperpolymath.org/errors/MaridCore.NotFoundError", which is not
+# stable (a module rename changes the URI) and is not a human-readable title
+# (recon-2026-10-21, C10).
+error_slug(::NotFoundError) = "not-found"
+error_slug(::ValidationError) = "validation"
+error_slug(::UnauthorizedError) = "unauthorized"
+error_slug(::ConflictError) = "conflict"
+error_slug(::TimeoutError) = "timeout"
+error_slug(::InternalError) = "internal"
+error_slug(::MaridError) = "error"
+
+const _ERROR_TITLES = Dict{String, String}(
+    "not-found" => "Not Found",
+    "validation" => "Validation Failed",
+    "unauthorized" => "Unauthorized",
+    "conflict" => "Conflict",
+    "timeout" => "Gateway Timeout",
+    "internal" => "Internal Server Error",
+    "error" => "Error",
+)
+
+"""
+    problem_details(err::MaridError; instance::String="", trace_id=nothing) -> Dict{String,Any}
+
+Map a domain error to an RFC 9457 problem detail object.
+
+`type` is `https://marid.hyperpolymath.org/problems/<slug>` where `<slug>` is
+stable across renames, `title` is the HTTP reason phrase for the kind, `detail`
+is the message, and `trace_id` (when given) is carried as an extension member so
+a client can quote a request id in a bug report without exposing internals.
+"""
+function problem_details(err::MaridError; instance::String="",
+                         trace_id::Union{Nothing, String}=nothing)::Dict{String, Any}
+    slug = error_slug(err)
+    document = Dict{String, Any}(
+        "type" => "https://marid.hyperpolymath.org/problems/$slug",
+        "title" => get(_ERROR_TITLES, slug, "Error"),
         "status" => status_code(err),
         "detail" => err.message,
-        "instance" => isempty(instance) ? "/errors/$(typeof(err))" : instance
+        "instance" => isempty(instance) ? "/problems/$slug" : instance
     )
+    trace_id === nothing || (document["trace_id"] = trace_id)
+    return document
 end
diff --git a/packages/MaridCore/test/runtests.jl b/packages/MaridCore/test/runtests.jl
index 5efb0d7..dd07530 100644
--- a/packages/MaridCore/test/runtests.jl
+++ b/packages/MaridCore/test/runtests.jl
@@ -4,6 +4,13 @@
 using Test
 using MaridCore
 
+# Declared at top level: `struct` is not allowed inside a `@testset`. This type
+# exists only to exercise the `::MaridError` fallbacks, which no shipped error
+# kind reaches because each one has its own method.
+struct UnmappedTestError <: MaridError
+    message::String
+end
+
 @testset "MaridCore Complete Suite" begin
     # 1. Error Mapping & Problem Details
     @testset "RFC 9457 Domain Errors" begin
@@ -24,6 +31,39 @@ using MaridCore
         @test status_code(timeout) == 504
     end
 
+    # 1b. Stable problem-detail identifiers (C10)
+    @testset "Problem details identify the kind, stably" begin
+        pd = problem_details(NotFoundError("Taxon", "42"))
+        # Not "…/errors/MaridCore.NotFoundError": the type is a stable slug.
+        @test pd["type"] == "https://marid.hyperpolymath.org/problems/not-found"
+        @test pd["title"] == "Not Found"
+        @test pd["instance"] == "/problems/not-found"
+        @test pd["status"] == 404
+        @test occursin("42", pd["detail"])
+
+        @test error_slug(ValidationError("bad", "email", "required")) == "validation"
+        @test problem_details(UnauthorizedError())["title"] == "Unauthorized"
+        @test problem_details(ConflictError("c", "r", "v"))["status"] == 409
+        @test problem_details(TimeoutError("t", 1.0))["status"] == 504
+
+        # Unknown subclasses still map to a sane slug rather than throwing.
+        # `InternalError` has its own method, so it cannot test the fallback;
+        # this uses a subtype the module does not know about.
+        @test error_slug(UnmappedTestError("boom")) == "error"
+        @test status_code(UnmappedTestError("boom")) == 500
+        fallback = problem_details(UnmappedTestError("boom"))
+        @test fallback["type"] == "https://marid.hyperpolymath.org/problems/error"
+        @test fallback["title"] == "Error"
+        @test fallback["status"] == 500
+        # The shipped kinds still resolve to their own slugs.
+        @test error_slug(InternalError("boom")) == "internal"
+
+        # A trace id travels with the problem, as an extension member.
+        traced = problem_details(InternalError("safe"), trace_id="abc-123")
+        @test traced["trace_id"] == "abc-123"
+        @test occursin("safe", traced["detail"])
+    end
+
     # 2. CallContext Lifecycle & Cancellation
     @testset "CallContext Semantics" begin
         ctx = create_context(principal="user:dr_smith", tenant="biology_dept", timeout_ms=500)
